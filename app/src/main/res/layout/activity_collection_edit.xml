<org.lineageos.tv.launcher.view.FocusScrollingScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="350dp"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/collection_edit_header"
            style="@style/SideActivityHeaderStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/my_collections" />

        <org.lineageos.tv.launcher.view.FocusHighlightCardView
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/collection_name"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <EditText
                    android:id="@+id/collection_name_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/collection_name"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

            </LinearLayout>

        </org.lineageos.tv.launcher.view.FocusHighlightCardView>

        <TextView
            style="@style/SideActivityHeaderStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/collection_apps" />

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/collection_apps_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <org.lineageos.tv.launcher.view.FocusHighlightCardView
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/collection_grid_view"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    style="@style/Widget.Catapult.SettingsSwitch"
                    android:id="@+id/collection_grid_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </org.lineageos.tv.launcher.view.FocusHighlightCardView>

        <LinearLayout
            android:id="@+id/collection_grid_columns_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <org.lineageos.tv.launcher.view.FocusHighlightCardView
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/collection_grid_columns"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <com.google.android.material.slider.Slider
                        style="@style/Widget.Catapult.SettingsSlider"
                        android:id="@+id/collection_grid_columns_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:valueFrom="4"
                        android:valueTo="10"
                        android:stepSize="1"
                        app:labelBehavior="floating" />

                    <TextView
                        android:id="@+id/collection_grid_columns_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorPrimary" />

                </LinearLayout>

            </org.lineageos.tv.launcher.view.FocusHighlightCardView>

        </LinearLayout>

        <org.lineageos.tv.launcher.view.FocusHighlightCardView
            style="@style/Widget.Material3.CardView.Outlined"
            android:id="@+id/collection_card_size_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/collection_card_size"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <com.google.android.material.slider.Slider
                    style="@style/Widget.Catapult.SettingsSlider"
                    android:id="@+id/collection_card_size_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:valueFrom="60"
                    android:valueTo="140"
                    android:stepSize="10"
                    app:labelBehavior="floating" />

                <TextView
                    android:id="@+id/collection_card_size_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>

        </org.lineageos.tv.launcher.view.FocusHighlightCardView>

        <org.lineageos.tv.launcher.view.FocusHighlightCardView
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/collection_corner_radius"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <com.google.android.material.slider.Slider
                    style="@style/Widget.Catapult.SettingsSlider"
                    android:id="@+id/collection_corner_radius_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:valueFrom="0"
                    android:valueTo="20"
                    android:stepSize="1"
                    app:labelBehavior="floating" />

                <TextView
                    android:id="@+id/collection_corner_radius_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>

        </org.lineageos.tv.launcher.view.FocusHighlightCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/collection_delete_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:text="@string/delete_collection" />

    </LinearLayout>

</org.lineageos.tv.launcher.view.FocusScrollingScrollView>
