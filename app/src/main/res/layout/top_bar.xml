<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/top_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="true"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="48dp"
    android:paddingTop="32dp"
    android:paddingEnd="48dp"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/assistantHintImageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:src="@drawable/ic_search" />

    <LinearLayout
        android:id="@+id/assistant_buttons"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:background="@drawable/search_background"
        android:padding="0dp"
        android:clipToOutline="true"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/voice_assistant"
            android:contentDescription="@string/mic_assistant"
            android:src="@drawable/ic_mic"
            style="@style/TopBarSearchButton" />

        <ImageButton
            android:id="@+id/keyboard_assistant"
            android:contentDescription="@string/keyboard_assistant"
            android:src="@drawable/ic_keyboard"
            style="@style/TopBarSearchButton" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end|center_vertical">

        <TextClock
            android:id="@+id/clockTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:textSize="32sp"
            android:textColor="@android:color/white"
            android:shadowColor="@color/label_shadow"
            android:shadowRadius="6.0"
            android:shadowDy="2"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <LinearLayout
            android:id="@+id/topBarButtonsGroup"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/search_background"
            android:padding="0dp"
            android:clipToOutline="true">

            <ImageButton
                android:id="@+id/vpnButton"
                android:contentDescription="@string/vpn"
                android:src="@drawable/ic_vpn"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@id/assistantHintImageView"
                android:nextFocusRight="@id/notificationCountTextView"
                style="@style/TopBarSearchButton" />

            <LinearLayout
                android:id="@+id/notificationContainer"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/search_button_background"
                android:nextFocusLeft="@id/vpnButton"
                android:nextFocusRight="@id/settingsMaterialButton">

                <ImageView
                    android:id="@+id/notificationBellIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_bell"
                    android:tint="@color/search_button_icon_color"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/notificationCountTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/search_button_icon_color"
                    android:duplicateParentState="true"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/settingsMaterialButton"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings"
                style="@style/TopBarSearchButton" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
