<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/dynamicBackgroundContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/dynamicBackgroundLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/dynamicBgA"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/dynamicBgB"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/dynamicBgC"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

        </FrameLayout>

        <View
            android:id="@+id/dynamicBgScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/dynamic_bg_scrim" />

    </FrameLayout>

    <org.lineageos.tv.launcher.MainVerticalGridView
        android:id="@+id/main_vertical_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:verticalSpacing="8dp"
        android:saveEnabled="false"
        android:focusable="false"
        app:numberOfColumns="1"
        app:focusOutFront="true"
        app:focusOutEnd="true"
        app:focusOutSideStart="false"
        app:focusOutSideEnd="false" />

    <include
        layout="@layout/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</FrameLayout>
